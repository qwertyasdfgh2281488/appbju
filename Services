import Foundation

struct RecommendationService {

    static func recommendation(
        protein: Int,
        targetProtein: Int,
        water: Double,
        targetWater: Double
    ) -> String {

        if protein < targetProtein {
            return "Добавьте продукты с высоким содержанием белка."
        }

        if water < targetWater {
            return "Увеличьте потребление воды."
        }

        return "Сегодня все показатели находятся в норме."
    }

}
