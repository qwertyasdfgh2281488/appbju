import Foundation

struct NutritionCalculator {

    static func calculateBMR(weight: Double,
                             height: Double,
                             age: Int,
                             isMale: Bool) -> Double {

        if isMale {
            return 10 * weight + 6.25 * height - 5 * Double(age) + 5
        } else {
            return 10 * weight + 6.25 * height - 5 * Double(age) - 161
        }
    }

    static func calculateCalories(bmr: Double) -> Int {
        Int(bmr * 1.4)
    }

}
