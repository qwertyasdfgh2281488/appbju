import Foundation

struct Food: Identifiable {

    let id = UUID()

    var name: String

    var calories: Int

    var protein: Double

    var fat: Double

    var carbs: Double

}
-------------------
import Foundation

struct Meal: Identifiable {

    let id = UUID()

    var title: String

    var foods: [Food]

}
