import Foundation
import Combine

final class HomeViewModel: ObservableObject {

    @Published var calories = 1450
    @Published var targetCalories = 2200

    @Published var protein = 95
    @Published var targetProtein = 150

    @Published var water = 1.8
    @Published var targetWater = 2.5

    var dailyScore: Int {

        let caloriePart = min(Int(Double(calories) / Double(targetCalories) * 50), 50)
        let proteinPart = min(Int(Double(protein) / Double(targetProtein) * 30), 30)
        let waterPart = min(Int(water / targetWater * 20), 20)

        return caloriePart + proteinPart + waterPart
    }

    var recommendation: String {

        if protein < targetProtein {
            return "Добавьте больше белка в рацион."
        }

        if water < targetWater {
            return "Не забудьте выпить воды."
        }

        return "Отличная работа! Все цели на сегодня выполнены."
    }

    func addCalories() {
        calories += 100
    }

    func addProtein() {
        protein += 10
    }

    func addWater() {
        water += 0.25
    }
}
