          import SwiftUI

struct StatisticsView: View {

    @State private var calories = 1450
    @State private var target = 2200

    @State private var protein = 95.0
    @State private var fat = 42.0
    @State private var carbs = 180.0

    var progress: Double {
        Double(calories) / Double(target)
    }

    var body: some View {

        ScrollView {

            VStack(spacing: 20) {

                Text("Статистика")
                    .font(.largeTitle)
                    .bold()

                VStack(alignment: .leading, spacing: 12) {

                    Text("Выполнение нормы")

                    ProgressView(value: progress)
                        .tint(.green)

                    Text("\(Int(progress * 100))%")

                }
                .padding()
                .background(.ultraThinMaterial)
                .clipShape(RoundedRectangle(cornerRadius: 20))

                StatRow(
                    title: "Калории",
                    value: "\(calories) ккал",
                    color: .orange
                )

                StatRow(
                    title: "Белки",
                    value: "\(String(format: "%.0f", protein)) г",
                    color: .green
                )

                StatRow(
                    title: "Жиры",
                    value: "\(String(format: "%.0f", fat)) г",
                    color: .yellow
                )

                StatRow(
                    title: "Углеводы",
                    value: "\(String(format: "%.0f", carbs)) г",
                    color: .blue
                )

            }
            .padding()

        }

    }

}

struct StatRow: View {

    let title: String
    let value: String
    let color: Color

    var body: some View {

        HStack {

            Circle()
                .fill(color)
                .frame(width: 16, height: 16)

            Text(title)

            Spacer()

            Text(value)
                .bold()

        }
        .padding()
        .background(.ultraThinMaterial)
        .clipShape(RoundedRectangle(cornerRadius: 18))

    }

}

