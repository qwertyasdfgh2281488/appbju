  import SwiftUI

struct DiaryView: View {

    @StateObject private var viewModel = DiaryViewModel()

    var body: some View {

        NavigationStack {

            List {

                Section("Добавить продукт") {

                    TextField("Название", text: $viewModel.foodName)

                    TextField("Калории", text: $viewModel.calories)
                        .keyboardType(.numberPad)

                    TextField("Белки", text: $viewModel.protein)
                        .keyboardType(.decimalPad)

                    TextField("Жиры", text: $viewModel.fat)
                        .keyboardType(.decimalPad)

                    TextField("Углеводы", text: $viewModel.carbs)
                        .keyboardType(.decimalPad)

                    Button {

                        withAnimation {
                            viewModel.addFood()
                        }

                    } label: {

                        Label("Добавить продукт", systemImage: "plus.circle.fill")
                            .frame(maxWidth: .infinity)

                    }
                    .buttonStyle(.borderedProminent)

                }

                Section("Дневник") {

                    ForEach(viewModel.meals) { food in

                        VStack(alignment: .leading, spacing: 8) {

                            HStack {

                                Text(food.name)
                                    .font(.headline)

                                Spacer()

                                Text("\(food.calories) ккал")
                                    .foregroundStyle(.orange)
                                    .bold()

                            }

                            HStack(spacing: 18) {

                                Label("\(String(format: "%.1f", food.protein)) Б", systemImage: "bolt.fill")
                                    .foregroundStyle(.green)

                                Label("\(String(format: "%.1f", food.fat)) Ж", systemImage: "drop.fill")
                                    .foregroundStyle(.yellow)

                                Label("\(String(format: "%.1f", food.carbs)) У", systemImage: "leaf.fill")
                                    .foregroundStyle(.blue)

                            }
                            .font(.caption)

                        }
                        .padding(.vertical, 4)

                    }
                    .onDelete(perform: viewModel.delete)

                }

                Section("Итого за день") {

                    HStack {

                        Text("Калории")

                        Spacer()

                        Text("\(viewModel.totalCalories)")
                            .bold()

                    }

                    HStack {

                        Text("Белки")

                        Spacer()

                    Text("\(String(format: "%.1f", viewModel.totalProtein)) г")

                    }

                    HStack {

                        Text("Жиры")

                        Spacer()

                        Text("\(String(format: "%.1f", viewModel.totalFat)) г")
                    }

                    HStack {

                        Text("Углеводы")

                        Spacer()

                        Text("\(String(format: "%.1f", viewModel.totalCarbs)) г")

                    }

                }

            }
            .navigationTitle("Дневник питания")

        }

    }

}

