    import SwiftUI

struct HomeView: View {

    @ObservedObject var viewModel: HomeViewModel

    var body: some View {

        ScrollView {

            VStack(spacing: 25) {

                VStack(alignment: .leading, spacing: 5) {

                    Text("Добро пожаловать 👋")
                        .font(.title2)
                        .fontWeight(.medium)

                    Text("NutriTrack")
                        .font(.largeTitle)
                        .fontWeight(.bold)

                }
                .frame(maxWidth: .infinity, alignment: .leading)

                CalorieRing(
                    calories: viewModel.calories,
                    target: viewModel.targetCalories
                )

                VStack(spacing: 15) {

                    HStack {

                        StatCard(
                            title: "Белки",
                            value: "\(viewModel.protein) г",
                            icon: "bolt.fill",
                            color: .green
                        )

                        StatCard(
                            title: "Вода",
                            value: String(format: "%.1f л", viewModel.water),
                            icon: "drop.fill",
                            color: .blue
                        )

                    }

                    HStack {

                        StatCard(
                            title: "Калории",
                            value: "\(viewModel.calories)",
                            icon: "flame.fill",
                            color: .orange
                        )

                        StatCard(
                            title: "Рейтинг",
                            value: "\(viewModel.dailyScore)",
                            icon: "star.fill",
                            color: .yellow
                        )

                    }

                }

                VStack(alignment: .leading, spacing: 15) {

                    Text("Быстрые действия")
                        .font(.headline)

                    Button {

                        withAnimation(.spring()) {
                            viewModel.addCalories()
                        }

                    } label: {

                        Label("+100 ккал", systemImage: "plus.circle.fill")
                            .frame(maxWidth: .infinity)

                    }
                    .buttonStyle(.borderedProminent)

                    Button {

                        withAnimation(.spring()) {
                            viewModel.addProtein()
                        }

                    } label: {

                        Label("+10 г белка", systemImage: "bolt.fill")
                            .frame(maxWidth: .infinity)

                    }
                    .buttonStyle(.borderedProminent)

                    Button {

                        withAnimation(.spring()) {
                            viewModel.addWater()
