      import SwiftUI

struct ProfileView: View {

    @State private var name = "Студент"
    @State private var age = 18
    @State private var height = 175
    @State private var weight = 70
    @State private var goal = "Поддержание"

    let goals = [
        "Похудение",
        "Поддержание",
        "Набор массы"
    ]

    var calories: Int {

        switch goal {

        case "Похудение":
            return Int(Double(weight) * 24 * 0.85)

        case "Набор массы":
            return Int(Double(weight) * 24 * 1.20)

        default:
            return Int(Double(weight) * 24)

        }

    }

    var body: some View {

        NavigationStack {

            Form {

                Section("Пользователь") {

                    TextField("Имя", text: $name)

                    Stepper("Возраст: \(age)", value: $age, in: 10...90)

                    Stepper("Рост: \(height) см", value: $height, in: 120...230)

                    Stepper("Вес: \(weight) кг", value: $weight, in: 30...200)

                }

                Section("Цель") {

                    Picker("Выберите цель", selection: $goal) {

                        ForEach(goals, id: \.self) { goal in

                            Text(goal)

                        }

                    }

                }

                Section("Результат") {

                    HStack {

                        Text("Норма калорий")

                        Spacer()

                        Text("\(calories) ккал")
                            .bold()
                            .foregroundStyle(.green)

                    }

                }

            }
            .navigationTitle("Профиль")

        }

    }

}

